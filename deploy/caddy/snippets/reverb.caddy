# WebSocket proxy for Laravel Reverb.
#
# Prefer nesting inside your existing route block (matches bbq.fiskkarta.com setup):
#
#   route {
#       import /path/to/alexbbq/deploy/caddy/snippets/reverb.caddy
#       handle {
#           try_files {path} {path}/ /index.php?{query}
#           php_fastcgi unix//run/php/php8.4-fpm.sock
#           file_server
#       }
#   }

# Proxies to Reverb on localhost. Port must match REVERB_SERVER_PORT in .env (default 8081).

handle /app/* {
	reverse_proxy 127.0.0.1:8081
}
