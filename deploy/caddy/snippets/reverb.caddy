# Import inside your site block, before the Laravel / php_fastcgi handlers.
#
# Example:
#   bbq.fiskkarta.com {
#       import /path/to/alexbbq/deploy/caddy/snippets/reverb.caddy
#       root * /path/to/alexbbq/public
#       ...
#   }
#
# Echo connects to wss://your-host/app/{REVERB_APP_KEY} on the same hostname
# as the app (REVERB_HOST / VITE_REVERB_HOST in .env).

handle /app/* {
	reverse_proxy 127.0.0.1:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
