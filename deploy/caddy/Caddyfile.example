# Caddyfile for the Pi — installed by deploy/install-pi-production.sh (or copy manually).
#
# Prerequisites:
#   1. Caddy ARMv6 + Cloudflare DNS: sudo ./deploy/install-caddy-armv6.sh
#   2. CLOUDFLARE_API_TOKEN in deploy/systemd/caddy.service.d/cloudflare.conf
#   3. Reverb running: sudo ./deploy/install-reverb-service.sh
#
# Validate: sudo caddy validate --config /etc/caddy/Caddyfile
# Reload:   sudo systemctl reload caddy

import /var/www/alexbbq/deploy/caddy/snippets/tls-cloudflare.caddy

bbqpi.local {
	tls internal

	# WebSockets for Laravel Reverb (local LAN testing).
	import /var/www/alexbbq/deploy/caddy/snippets/reverb.caddy

	root * /var/www/alexbbq/public
	encode gzip zstd

	route {
		import /var/www/alexbbq/deploy/caddy/snippets/pwa-cache.caddy

		try_files {path} {path}/ /index.php?{query}
		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}
}

bbq.fiskkarta.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	root * /var/www/alexbbq/public
	encode gzip zstd

	route {
		import /var/www/alexbbq/deploy/caddy/snippets/reverb.caddy
		import /var/www/alexbbq/deploy/caddy/snippets/pwa-cache.caddy

		handle {
			try_files {path} {path}/ /index.php?{query}
			php_fastcgi unix//run/php/php8.4-fpm.sock
			file_server
		}
	}
}
