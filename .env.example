APP_NAME=Alex.bbq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required on HTTPS production (Pi) so session cookies are sent on Livewire POSTs.
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Generated automatically by `composer setup` (runs `php artisan reverb:configure`).
# Public WebSocket connection (browser). Defaults match `php artisan serve` + `reverb:start --port=8080`.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Server-side broadcast API. Omit on local dev (inherits REVERB_* on port 8080). See Production (Pi) example below.
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_SERVER_SCHEME=http

# Laravel Herd (https://alexbbq.test) — replace the REVERB_* block above:
#   APP_URL=https://alexbbq.test
#   REVERB_HOST=alexbbq.test
#   REVERB_PORT=8080
#   REVERB_SCHEME=https
#   php artisan reverb:start --port=8080
# REVERB_VERIFY_SSL defaults to false when APP_ENV=local (Herd self-signed cert).

# Reverb client settings above are injected at runtime by Laravel (see partials/head.blade.php).
# No VITE_REVERB_* vars needed — build assets once, deploy anywhere.
#
# Browser origins allowed to open WebSocket connections (defaults to APP_URL).
# Local dev auto-adds localhost when APP_URL uses 127.0.0.1 (and vice versa).
# Set explicitly only for other host/port mismatches:
# REVERB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Local dev without Raspberry Pi hardware: maverick-fake.sh is used automatically
# when APP_ENV=local. Override with MAVERICK_SCRIPT / MAVERICK_USE_SUDO if needed.
# MAVERICK_SCRIPT=/absolute/path/to/alexbbq/maverick-fake.sh
# MAVERICK_USE_SUDO=false
# MAVERICK_FAKE_INTERVAL=12
# MAVERICK_FAKE_BBQ_TARGET=225
# Only set if auto-detection fails (Herd usually does not need this):
# MAVERICK_PHP="/Users/you/Library/Application Support/Herd/bin/php"

# Production (Pi) example — after Caddy + deploy/install-reverb-service.sh:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://bbq.fiskkarta.com
# SESSION_SECURE_COOKIE=true
# REVERB_HOST=bbq.fiskkarta.com
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8081
# REVERB_SERVER_SCHEME=http
# Then: php artisan config:cache

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Used by cloudflare-ddns.sh (cron every 5 minutes on the Pi; script rotates its own log)
#   */5 * * * * /path/to/alexbbq/cloudflare-ddns.sh
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DNS_RECORD=
CLOUDFLARE_IP_CHECK_URL=https://api.ipify.org
