APP_NAME=Maverick.bbq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public hostname/port the browser connects to (via Caddy wss://).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb process on this machine (must match Caddy reverse_proxy target).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
REVERB_SERVER_SCHEME=http

# Reverb client settings above are injected at runtime by Laravel (see partials/head.blade.php).
# No VITE_REVERB_* vars needed — build assets once, deploy anywhere.

# Production (Pi) example — after Caddy + deploy/install-reverb-service.sh:
# APP_URL=https://bbq.fiskkarta.com
# REVERB_HOST=bbq.fiskkarta.com
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8081
# REVERB_SERVER_SCHEME=http
# Then: php artisan config:cache

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Used by cloudflare-ddns.sh (cron every 5 minutes on the Pi; script rotates its own log)
#   */5 * * * * /path/to/alexbbq/cloudflare-ddns.sh
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DNS_RECORD=bbq.fiskkarta.com
CLOUDFLARE_IP_CHECK_URL=https://api.ipify.org
